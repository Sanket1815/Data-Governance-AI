# --- GCP / BigQuery ---
GCP_PROJECT_ID=project-d60256f0-58d4-461d-86f
BIGQUERY_DATASET=healthcare_insurance
GCP_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- LLM provider: "gemini" or "openai" ---
LLM_PROVIDER=gemini

# Gemini
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_PRIMARY_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-pro-latest

# OpenAI (only used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-key
OPENAI_PRIMARY_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o

EMBEDDING_MODEL=gemini-embedding-001

# --- Redis semantic cache ---
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.1

# --- Query engine tuning ---
TABLE_RETRIEVER_TOP_K=3
SELF_HEALING_MAX_RETRIES=3
MAX_BYTES_BILLED=1073741824
QUERY_RESULT_ROW_LIMIT=1000

# --- API ---
API_CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# --- Anomaly / Feature Store engine ---
GCS_ARTIFACT_BUCKET=project-d60256f0-58d4-461d-86f-fwa-artifacts
ANOMALY_CONTAMINATION=0.03
ANOMALY_RANDOM_STATE=42
ANOMALY_REVIEW_SCORE_THRESHOLD=70.0
MEMBER_VELOCITY_WINDOW_DAYS=30

# --- Data Governance Catalog (Dataplex) ---
DATAPLEX_LOCATION=us
DATAPLEX_DATASCAN_LOCATION=us-central1
DATAPLEX_ENTRY_GROUP=@bigquery
DATAPLEX_GLOSSARY_ID=data-governance-glossary
DATAPLEX_GOVERNANCE_ASPECT_TYPE_ID=data-governance-tag
