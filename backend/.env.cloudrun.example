# Paste into Cloud Run → Service → Edit → Variables → "Paste a .env file"
# Replace placeholders before pasting. Do NOT set GOOGLE_APPLICATION_CREDENTIALS on Cloud Run.
# Attach service account: data-governance-backend@project-d60256f0-58d4-461d-86f.iam.gserviceaccount.com
# Prefer Secret Manager for GOOGLE_API_KEY instead of plain text below.

GCP_PROJECT_ID=project-d60256f0-58d4-461d-86f
BIGQUERY_DATASET=healthcare_insurance
GCP_LOCATION=US
LLM_PROVIDER=gemini
GOOGLE_API_KEY=REPLACE_WITH_AI_STUDIO_KEY_OR_USE_SECRET_MANAGER
GEMINI_PRIMARY_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-pro-latest
EMBEDDING_MODEL=gemini-embedding-001
